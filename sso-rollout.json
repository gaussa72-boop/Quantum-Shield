{
  "schema_version": 1,
  "service": "ULTIMA Central Identity",
  "rollout_mode": "disabled_until_migration_and_security_review",
  "identity_model": "global_user_with_site_memberships",
  "authorization_flow": "oauth2_authorization_code_pkce",
  "allowed_sites": [
    "astralis-omega",
    "novatube",
    "ate-rea-vermachtnis",
    "quantum-ai",
    "ki-game-mod",
    "note-ki",
    "ipad-app-ionos-7",
    "galactic-ai-v3",
    "quantum-super-intelligence",
    "ionos-8",
    "quantum-ki-cat-chat",
    "ai-quantumlight",
    "quantenformel",
    "quantum-singularity",
    "ionos-ai",
    "quantum-ai-one",
    "quantum-ki-ultra-pro-v2-renewed",
    "quantum-mirror-wonderland",
    "ionos-ki",
    "ionos-7",
    "ultraki-ai",
    "ultra-ki-v2",
    "quantum-ki-ultra-pro-v2",
    "quantumai-chat",
    "trinity-trading",
    "lichtkrieger"
  ],
  "excluded_sites": [
    "royal-palace-4r57",
    "business-real-estate-membership",
    "aktiv-lyca-rgds",
    "aktiv-lyca-rnmc",
    "dropshift-store",
    "bullrun-apparel",
    "sneaker-store",
    "webshop-parfum",
    "rea-signature"
  ],
  "rules": {
    "no_shared_cookies_across_domains": true,
    "require_exact_registered_redirect_uri": true,
    "require_pkce_s256": true,
    "one_time_authorization_codes": true,
    "short_lived_access_tokens": true,
    "refresh_token_rotation": true,
    "preserve_site_scoped_credits_and_orders": true,
    "never_auto_merge_accounts_by_email_without_verified_control": true,
    "existing_password_hashes_must_be_validated_before_migration": true,
    "no_production_activation_before_backup_and_migration_tests": true
  },
  "notes": [
    "This file is a rollout policy only. It does not activate SSO.",
    "The allowed list is explicit; unknown sites are denied by default.",
    "Rothshild, Lyca and all webshops including Rea Signature remain excluded.",
    "Existing site-scoped accounts remain authoritative until a tested migration is approved."
  ]
}
